/**
 * Cấu hình định tuyến Viewstreet.
 *
 * LƯU Ý: các trọng số dưới đây là THAM SỐ KHỞI TẠO do nhóm tự chọn, chưa được
 * kiểm chứng bằng lý thuyết hay thực nghiệm. Cần hiệu chỉnh bằng mô phỏng /
 * đo thực tế (tuổi thọ pin, độ lệch tải, độ trễ) trước khi dùng cho kết luận.
 *
 * Cost của một đoạn u -> v:
 *   a·1 + b·(1 − pin_v) + c·(1 − quality(rssi_uv)) + d·tải_v
 * Tổng cost của tuyến = tổng cost các đoạn. Gateway không có pin/tải nên
 * đoạn kết thúc ở gateway chỉ tính hop + RSSI.
 */
module.exports = {
    // Trọng số công thức Cost
    weights: {
        hop: 1.0,   // a
        battery: 2.0, // b
        rssi: 1.5,  // c
        load: 1.0,  // d
    },

    // Chuẩn hóa RSSI (dBm) về chất lượng [0, 1]: rssiBad -> 0, rssiGood -> 1
    rssi: { good: -30, bad: -100 },

    // Giá trị dùng khi node THIẾU số liệu (null/undefined/NaN). Số 0 hợp lệ không bị coi là thiếu.
    // Chọn thiên về thận trọng để node không báo cáo không được ưu tiên.
    defaults: { bat: 50, rssi: -85, load: 50 },

    // Nút đích của mọi gói tin
    gateway: 'gateway',

    // Topology: danh sách liên kết có hướng (from -> to).
    // Ghi đè RSSI từng liên kết (nếu có) qua state.links["from->to"].rssi.
    // Nếu không có, dùng rssi do node `from` báo cáo.
    links: [
        ['node_1', 'gateway'],
        ['node_1', 'node_2'],
        ['node_1', 'node_3'],
        ['node_2', 'gateway'],
        ['node_3', 'gateway'],
        ['node_2', 'node_3'],
        ['node_3', 'node_2'],
    ],

    // Tuyến không tồn tại (nguồn offline, không có đường tới gateway)
    unreachableCost: Infinity,
};